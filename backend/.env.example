DB_URL=sqlite:///./team08.db
POLITE_POOL_EMAIL=your-email@example.com

# Comma-separated list of origins allowed to call this API (CORS). Defaults
# to the Vite dev server; set to the real frontend origin(s) in production.
CORS_ORIGINS=http://localhost:5173

HTTP_TIMEOUT_CONNECT_S=10
HTTP_TIMEOUT_READ_S=30
HTTP_TIMEOUT_SOURCE_TOTAL_S=60
HTTP_TIMEOUT_COLLECTION_SOFT_LIMIT_S=600

MAX_ARTICLES_PER_KEYWORD=100

RATE_LIMIT_ARXIV_INTERVAL_S=3
RATE_LIMIT_OPENALEX_RPS=10
RATE_LIMIT_CROSSREF_RPS=50
RATE_LIMIT_PUBMED_RPS=3
RATE_LIMIT_SEMANTIC_SCHOLAR_RPS=1

# Optional - neither source requires a key to run.
PUBMED_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

CACHE_TTL_HOURS=24
LOG_LEVEL=INFO